#!/bin/bash

# Claude2-D2 macOS App — notification identity for Claude Code droid banners.
# macOS launches this when a Claude2-D2 notification is clicked: jump to the
# iTerm2 tab of this droid's most recent notification.

UUID=$(cat ~/.claude/droid-state/click-r2d2 2>/dev/null)
if [ -n "$UUID" ] && [ -x ~/.claude/droid-focus.sh ]; then
    exec ~/.claude/droid-focus.sh "$UUID"
fi
exit 0
